<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет, оформление «Графит и изумруд». Тот же набор id, что у второго варианта. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wb_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/w_b_text"
            android:textSize="17sp"
            android:textStyle="normal" />
        <ImageView
            android:id="@+id/add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/wb_add"
            android:contentDescription="@string/add"
            android:padding="9dp"
            android:src="@drawable/ic_add_b" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/q1"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_chip"
            android:text="@string/q1" />
        <TextView
            android:id="@+id/q2"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_chip"
            android:text="@string/q2" />
        <TextView
            android:id="@+id/q4"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/wb_chip"
            android:text="@string/q4" />
    </LinearLayout>

    <!-- Неделя вперёд: подписи («Завтра», «Послезавтра», «Вс 18»), фон и цвет выходных ставит Widget.render. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/d1"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_day" />
        <TextView
            android:id="@+id/d2"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_day" />
        <TextView
            android:id="@+id/d3"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/wb_day" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/d4"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_day" />
        <TextView
            android:id="@+id/d5"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_day" />
        <TextView
            android:id="@+id/d6"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/wb_day" />
        <TextView
            android:id="@+id/d7"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/w_b_text"
            android:textSize="13sp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/wb_day" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wb_row"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/time1"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_b_text"
            android:textSize="13.5sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/w_b_text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_b_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wb_row"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/time2"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_b_text"
            android:textSize="13.5sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/w_b_text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_b_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wb_row"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/time3"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_b_text"
            android:textSize="13.5sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/w_b_text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/sub3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_b_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="@string/empty"
        android:textColor="@color/w_b_sub"
        android:textSize="13sp" />
</LinearLayout>
